{
  "$id": "appsettings.json",
  "$comments": "Default settings for SnapsInAZfs. It is not recommended to modify this file. Customized settings should be specified in /etc/SnapsInAZfs/SnapsInAZfs.local.json, and will override settings of the same name in this file.",
  "DryRun": false,
  "TakeSnapshots": false,
  "PruneSnapshots": false,
  "LocalSystemName": "StandaloneSiazSystem",
  "Daemonize": false,
  "DaemonTimerIntervalSeconds": 10,
  "ZfsPath": "/usr/local/sbin/zfs",
  "ZpoolPath": "/usr/local/sbin/zpool",
  "Templates":
  {
    "default":
    {
      "Formatting":
      {
        "ComponentSeparator": "_",
        "Prefix": "autosnap",
        "TimestampFormatString": "yyyy-MM-dd_HH\\:mm\\:ss",
        "FrequentSuffix": "frequently",
        "HourlySuffix": "hourly",
        "DailySuffix": "daily",
        "WeeklySuffix": "weekly",
        "MonthlySuffix": "monthly",
        "YearlySuffix": "yearly"
      },
      "SnapshotTiming":
      {
        "FrequentPeriod": 15,
        "HourlyMinute": 0,
        "DailyTime": "00:00:00",
        "WeeklyDay": 1,
        "WeeklyTime": "00:00:00",
        "MonthlyDay": 1,
        "MonthlyTime": "00:00:00",
        "YearlyMonth": 1,
        "YearlyDay": 1,
        "YearlyTime": "00:00:00"
      }
    }
  },
  "Monitoring":
  {
    "EnableHttp": false,
    "Kestrel":
    {
      "Limits":
      {
        "MaxConcurrentConnections": 20,
        "KeepAliveTimeout": 60
      }
    }
  },
  "NLog":
  {
    "autoReload": false,
    "throwConfigExceptions": false,
    "internalLogLevel": "Warn",
    "internalLogFile": "${basedir}/internal-nlog.txt",
    "extensions":
    [
      {
        "assembly": "NLog.Extensions.Logging"
      }
    ],
    "variables":
    {
      "var_logdir": "/var/log/SnapsInAZfs"
    },
    "time":
    {
      "type": "FastLocal"
    },
    "default-wrapper":
    {
      "type": "AsyncWrapper",
      "overflowAction": "Block"
    },
    "targets":
    {
      "all-file":
      {
        "type": "File",
        "fileName": "${var_logdir}/all/snapsinazfs-${shortdate}.log",
        "layout": "${longdate}|${pad:padding=-6:${uppercase:${level}}}|${logger:shortName=true}|${message} ${exception:format=tostring}|${callsite}${onexception:inner=\\:${callsite-linenumber}}"
      },
      "error-file":
      {
        "type": "File",
        "fileName": "${var_logdir}/error/snapsinazfs-error-${shortdate}.log",
        "layout": "${longdate}|${pad:padding=-6:${uppercase:${level}}}|${logger:shortName=true}|${message} ${exception:format=@}|${callsite}${onexception:inner=\\:${callsite-linenumber}}"
      },
      "own-console":
      {
        "type": "ColoredConsole",
        "layout": "${longdate}|${pad:padding=-6:${uppercase:${level}}}|${message} ${exception:format=tostring}",
        "rowHighlightingRules":
        [
          {
            "condition": "level == LogLevel.Warn",
            "foregroundColor": "Yellow"
          },
          {
            "condition": "level == LogLevel.Error",
            "foregroundColor": "Red"
          },
          {
            "condition": "level == LogLevel.Fatal",
            "foregroundColor": "White",
            "backgroundColor": "DarkRed"
          }
        ]
      },
      "own-console-debug":
      {
        "type": "ColoredConsole",
        "layout": "${longdate}|${pad:padding=-6:${uppercase:${level}}}|${logger:shortName=true}|${message} ${exception:format=tostring}|${callsite}${onexception:inner=\\:${callsite-linenumber}}",
        "rowHighlightingRules":
        [
          {
            "condition": "level == LogLevel.Warn",
            "foregroundColor": "Yellow"
          },
          {
            "condition": "level == LogLevel.Error",
            "foregroundColor": "Red"
          },
          {
            "condition": "level == LogLevel.Fatal",
            "foregroundColor": "White",
            "backgroundColor": "DarkRed"
          }
        ]
      },
      "own-console-messageonly":
      {
        "type": "ColoredConsole",
        "layout": "${message}",
        "rowHighlightingRules":
        [
          {
            "condition": "level == LogLevel.Warn",
            "foregroundColor": "Yellow"
          },
          {
            "condition": "level == LogLevel.Error",
            "foregroundColor": "Red"
          },
          {
            "condition": "level == LogLevel.Fatal",
            "foregroundColor": "Red",
            "backgroundColor": "White"
          }
        ]
      }
    },
    "rules":
    [
      {
        "ruleName": "MessageOnly",
        "logger": "MessageOnly",
        "minLevel": "Debug",
        "writeTo": "own-console-messageonly",
        "filterDefaultAction": "Log",
        "final": true
      },
      {
        "ruleName": "ErrorFile",
        "logger": "*",
        "minLevel": "Warn",
        "writeTo": "error-file",
        "filterDefaultAction": "Log",
        "final": false,
        "enabled": true
      },
      {
        "ruleName": "LogFile",
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "all-file",
        "filterDefaultAction": "Log",
        "final": false,
        "enabled": true
      },
      {
        "ruleName": "Console",
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "own-console",
        "filterDefaultAction": "Log",
        "enabled": true
      }
    ]
  }
}
